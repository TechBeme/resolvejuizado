# WordPress credentials (App Password authentication)
# Se o App Password tiver espaços, envolva em aspas.
WORDPRESS_BASE_URL=https://your-wordpress-site.com
WORDPRESS_APP_USER=your-app-user
WORDPRESS_APP_PASSWORD="your app password"

# Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI models (text, image) — inclua o provedor no nome do modelo (ex.: google/..., openai/...)
AI_TEXT_MODEL=google/gemini-3-pro-preview
AI_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# Provider keys
OPENAI_API_KEY=your-openai-api-key   # opcional, se usar openai
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key   # necessário para providers "google"

# Optional
# LOG_LEVEL=info

# Optional: HTTP Proxy (útil para GitHub Actions com bloqueio geográfico)
# Se configurado, todas as requisições HTTP/HTTPS usarão este proxy
# HTTP_PROXY=http://proxy-brasileiro.com:8080
# HTTPS_PROXY=http://proxy-brasileiro.com:8080
